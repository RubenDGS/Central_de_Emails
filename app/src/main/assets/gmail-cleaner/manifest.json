{
  "manifest_version": 2,
  "name": "Central de Emails - Gmail Cleaner",
  "version": "1.0",
  "applications": {
    "gecko": {
      "id": "gmail-cleaner@central-emails.local"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
